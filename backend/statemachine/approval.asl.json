{
  "Comment": "EDMS Document Approval Workflow - Draft -> Pending -> Approved/Rejected",
  "StartAt": "SetStatusPending",
  "States": {
    "SetStatusPending": {
      "Type": "Task",
      "Resource": "${ApprovalTasksFunctionArn}",
      "Parameters": {
        "action": "SET_PENDING",
        "docId.$": "$.docId",
        "department.$": "$.department"
      },
      "ResultPath": "$.pendingResult",
      "Next": "WaitForApproverDecision"
    },
    "WaitForApproverDecision": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${NotifyFunctionArn}",
        "Payload": {
          "docId.$": "$.docId",
          "taskToken.$": "$$.Task.Token"
        }
      },
      "TimeoutSeconds": 259200,
      "ResultPath": "$.decisionResult",
      "Next": "IsApproved"
    },
    "IsApproved": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.decisionResult.decision",
          "StringEquals": "APPROVED",
          "Next": "SetApproved"
        }
      ],
      "Default": "SetRejected"
    },
    "SetApproved": {
      "Type": "Task",
      "Resource": "${ApprovalTasksFunctionArn}",
      "Parameters": {
        "action": "SET_APPROVED",
        "docId.$": "$.docId",
        "department.$": "$.department"
      },
      "End": true
    },
    "SetRejected": {
      "Type": "Task",
      "Resource": "${ApprovalTasksFunctionArn}",
      "Parameters": {
        "action": "SET_REJECTED",
        "docId.$": "$.docId",
        "department.$": "$.department"
      },
      "End": true
    }
  }
}
